cabal-version:      3.0
name:               palisade
version:            0.1.0.0
synopsis:           A proof-gated execution kernel for machine-initiated money
description:
  PALISADE sits between any decision-maker (an AI agent, a strategy, a human,
  a scheduler) and the ledger. Money moves only with unforgeable evidence that
  every constraint holds, and every decision produces a reproducible
  certificate. See README.md.
license:            MIT
license-file:       LICENSE
author:             Sharif Parish
maintainer:         saintparish6@gmail.com
category:           Finance
build-type:         Simple
extra-doc-files:    README.md
                    CHANGELOG.md

source-repository head
    type:     git
    location: https://github.com/saintparish4/palisade

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -Wredundant-constraints

common lang
    default-language: GHC2021
    default-extensions:
        DataKinds
        GADTs
        LambdaCase
        OverloadedStrings
        RankNTypes
        TypeFamilies

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        Palisade.Currency
        Palisade.Money
        Palisade.Settlement
        Palisade.Canonical
        Palisade.Types
        Palisade.Ledger
        Palisade.Chain
        Palisade.Proof
        Palisade.Policy.Syntax
        Palisade.Policy.Parse
        Palisade.Policy.Expr
        Palisade.Policy.Check
        Palisade.Policy.Eval
        Palisade.Policy
        Palisade.Certificate
        Palisade.Authorize
        Palisade.Sign
        Palisade.Simulate
        Palisade.Stress
        Palisade.Bench
        Palisade.Render
        Palisade.CLI
    other-modules:
        Palisade.Proof.Internal
    build-depends:
        base >=4.18 && <5,
        aeson >=2.1 && <2.3,
        bytestring >=0.11 && <0.13,
        containers >=0.6 && <0.8,
        crypton >=1.1 && <1.2,
        directory >=1.3 && <1.4,
        filepath >=1.4 && <1.6,
        megaparsec >=9.3 && <9.8,
        optparse-applicative >=0.17 && <0.20,
        QuickCheck >=2.14 && <2.17,
        ram >=0.20 && <0.23,
        text >=2.0 && <2.2,
        time >=1.12 && <1.15

executable palisade
    import:           warnings, lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        base,
        palisade
    ghc-options: -threaded -rtsopts

test-suite palisade-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:
        Gen
        Palisade.MoneySpec
        Palisade.TypeSafetySpec
        Palisade.LedgerSpec
        Palisade.ChainSpec
        Palisade.PolicySpec
        Palisade.AuthorizeSpec
        Palisade.SimulateSpec
        Palisade.StressSpec
        Palisade.BenchSpec
    build-depends:
        base,
        palisade,
        aeson,
        bytestring,
        containers,
        directory,
        filepath,
        hspec >=2.10 && <2.12,
        QuickCheck,
        text,
        time
